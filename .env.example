# Reference only: export these values in your shell or service manager.
# Workbench does not automatically load .env. Never commit real configuration.
# Home node
HOST=127.0.0.1
PORT=4317
DATA_DIR=./.data
API_TOKEN=xxxxx
# Worker node
HOME_URL=ws://127.0.0.1:4317/worker
NODE_ID=xxxxx
NODE_NAME=xxxxx
WORKER_TOKEN=xxxxx
WORKER_DATA_DIR=./.local
WORKER_ROOTS=xxxxx
# Dedicated parent folder for projects and independent native sessions.
# Do not set this to the root of an existing managed project.
WORKSPACE_ROOT=xxxxx
WORKER_CONCURRENCY=2
# Optional CLI binaries
# CODEX_BIN=codex
# CLAUDE_BIN=claude
# GROK_BIN=grok
# AGY_BIN=agy
# CCUSAGE_BIN=ccusage
